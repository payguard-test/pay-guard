# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# The offline demo (npm run demo) and the sandbox demo (npm run demo:sandbox) need nothing here.

NEAR_NETWORK=testnet
# Optional. Default: https://test.rpc.fastnear.com (see https://docs.near.org/api/rpc/providers)
NEAR_RPC_URL=

# ---- Testnet demo: only these two are needed. npm run setup:testnet creates everything else
# ---- as sub-accounts and saves their keys to .pay-guard/testnet.json (git-ignored).
# A funded testnet account (about 8 NEAR from the faucet). Full-access key; keep it OFF the agent host.
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=

# ---- Running the checker service on its own (npm run checker)
PAYGUARD_CONTRACT_ID=
REGISTRY_CONTRACT_ID=
# ed25519 key that signs attestations. Generate with: npm run keygen
CHECKER_PRIVATE_KEY=
CHECKER_PORT=8787
# Optional NearBlocks settings. Default base: https://api-testnet.nearblocks.io
NEARBLOCKS_URL=
NEARBLOCKS_API_KEY=

# ---- npm run check -- <receiver> <amount>
CHECKER_URL=http://127.0.0.1:8787
AGENT_ACCOUNT_ID=
